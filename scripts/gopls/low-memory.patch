 func (c *parseCache) gcOnce() {
 	now := time.Now()
+	expireAfter := c.expireAfter
+	if heapOverMemoryLimit() {
+		expireAfter = min(expireAfter, parseCacheExpiryUnderPressure)
+	}
 	c.mu.Lock()
 	defer c.mu.Unlock()
 
 	for len(c.m) > parseCacheMinFiles {
 		e := heap.Pop(&c.lru).(*parseCacheEntry)
-		if now.Sub(e.walltime) >= c.expireAfter {
+		if now.Sub(e.walltime) >= expireAfter {
 			delete(c.m, e.key)
 		} else {
 			heap.Push(&c.lru, e)
 			break
 		}
 	}
+}
+
+const parseCacheExpiryUnderPressure = 1 * time.Second
+
+func heapOverMemoryLimit() bool {
+	limit := debug.SetMemoryLimit(-1)
+	if limit <= 0 || limit == math.MaxInt64 {
+		return false
+	}
+	sample := []metrics.Sample{{Name: "/gc/heap/live:bytes"}}
+	metrics.Read(sample)
+	if sample[0].Value.Kind() != metrics.KindUint64 {
+		return false
+	}
+	return sample[0].Value.Uint64() >= uint64(limit)
 }
 
