+func TestParseCache_ShortExpiryOverMemoryLimit(t *testing.T) {
+	skipIfNoParseCache(t)
+
+	ctx := context.Background()
+	fh := makeFakeFileHandle(protocol.DocumentURI("file:///myfile"), []byte("package p\n\nconst _ = \"foo\""))
+	files := dummyFileHandles(parseCacheMinFiles)
+
+	evicted := func(limit int64) bool {
+		old := debug.SetMemoryLimit(limit)
+		defer debug.SetMemoryLimit(old)
+		cache := newParseCache(time.Hour)
+		cache.stop()
+		fset := token.NewFileSet()
+		before, err := cache.parseFiles(ctx, fset, parsego.Full, false, fh)
+		if err != nil {
+			t.Fatal(err)
+		}
+		time.Sleep(parseCacheExpiryUnderPressure)
+		if _, err := cache.parseFiles(ctx, fset, parsego.Full, false, files...); err != nil {
+			t.Fatal(err)
+		}
+		cache.gcOnce()
+		after, err := cache.parseFiles(ctx, fset, parsego.Full, false, fh)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return before[0] != after[0]
+	}
+
+	if evicted(math.MaxInt64) {
+		t.Error("without a memory limit, a file parsed a second ago was evicted")
+	}
+	runtime.GC()
+	live := []metrics.Sample{{Name: "/gc/heap/live:bytes"}}
+	metrics.Read(live)
+	if !evicted(int64(live[0].Value.Uint64()) / 2) {
+		t.Error("over the memory limit, a file parsed a second ago was kept")
 	}
 }
