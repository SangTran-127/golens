--- a/internal/server/workspace_options_test.go
+++ b/internal/server/workspace_options_test.go
@@ -0,0 +1,21 @@
+package server
+
+import (
+	"testing"
+
+	"golang.org/x/tools/gopls/internal/settings"
+)
+
+func TestSameFolderOptionsIgnoresProcessWideSettings(t *testing.T) {
+	a := settings.DefaultOptions()
+	b := a.Clone()
+	b.MemoryLimit = 1 << 30
+	b.MaxFileCacheBytes = 1 << 28
+	if !sameFolderOptions(a, b) {
+		t.Error("a memoryLimit or maxFileCacheBytes change rebuilt the folder views")
+	}
+	b.Staticcheck = !a.Staticcheck
+	if sameFolderOptions(a, b) {
+		t.Error("a folder setting change was ignored")
+	}
+}
